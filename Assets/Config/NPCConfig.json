      "civilianActivityMultiplier": 1.1,
      "criminalActivityMultiplier": 0.9,
      "rabiesChanceMultiplier": 1.3,
      "notes": "Animals more active, rabies season begins"
    },
    "summer": {
      "animalSpawnMultiplier": 1.4,
      "militaryActivityMultiplier": 1.2,
      "civilianActivityMultiplier": 1.2,
      "criminalActivityMultiplier": 1.0,
      "rabiesChanceMultiplier": 1.5,
      "notes": "Peak activity, highest rabies risk, longer patrol hours"
    },
    "autumn": {
      "animalSpawnMultiplier": 1.1,
      "militaryActivityMultiplier": 1.0,
      "civilianActivityMultiplier": 1.0,
      "criminalActivityMultiplier": 1.1,
      "rabiesChanceMultiplier": 1.0,
      "notes": "Animals preparing for winter, slight increase in crime"
    },
    "winter": {
      "animalSpawnMultiplier": 0.4,
      "militaryActivityMultiplier": 0.8,
      "civilianActivityMultiplier": 0.7,
      "criminalActivityMultiplier": 1.5,
      "rabiesChanceMultiplier": 0.5,
      "notes": "Fewer animals, reduced patrols, desperate criminals and scavengers"
